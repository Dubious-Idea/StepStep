<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Runtime permission on Android 10+: the hardware step counter is
         treated as activity data, not a plain sensor. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Runtime permission on Android 13+; without it the lock-screen
         notification is created but never shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- StepTrackingService. Android 14+ requires the type-specific
         permission to match the foregroundServiceType declared below; the
         health type in turn requires ACTIVITY_RECOGNITION to be granted. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- Held for a few seconds around the 23:59 alarm, so the day's last
         steps are folded in before the CPU goes back to sleep. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- For the 23:59 daily-finalisation alarm, which must be exact: an
         inexact one may arrive up to an hour late, i.e. after midnight.
         USE_EXACT_ALARM (Android 13+) is granted at install and cannot be
         revoked; Google Play restricts it to alarm/calendar apps, but this
         app ships through GitHub Releases only. On Android 12 the older
         SCHEDULE_EXACT_ALARM is granted automatically. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Lets the profile screen offer the system's "ignore battery
         optimizations" prompt. Besides keeping Doze and OEM battery managers
         off the service, it lets the service restart itself from the
         background. Only used to show that one dialog — never granted
         silently. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Update checks against the GitHub Releases API. The app sends nothing
         and stores nothing server-side; this is the only network it uses. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Not required: a device without the sensor still installs and can show
         the profile screens, it just cannot count. -->
    <uses-feature
        android:name="android.hardware.sensor.stepcounter"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Keeps the step listener registered and the notification and
             widgets current, redrawing only while the screen is on. Not
             exported: only this app ever starts it. -->
        <service
            android:name=".StepTrackingService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Fired by the exact alarm RefreshScheduler arms for 23:59 and by
             the notification's delete intent, both via explicit
             PendingIntents — no intent-filter needed, and not exported since
             nothing outside this app ever targets it. -->
        <receiver
            android:name=".StepRefreshReceiver"
            android:exported="false" />

        <!-- Widget providers must be exported so the launcher can bind them.
             Three separate receivers rather than one responsive layout: the
             single-RemoteViews-per-size API needs API 31+, and minSdk here
             is 26. Distinct labels are what let the three tell themselves
             apart in the widget picker. -->
        <receiver
            android:name=".StepWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label_ring">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/step_widget_info" />
        </receiver>

        <receiver
            android:name=".StepWidgetProviderBar"
            android:exported="true"
            android:label="@string/widget_label_bar">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/step_widget_bar_info" />
        </receiver>

        <receiver
            android:name=".StepWidgetProviderGrid"
            android:exported="true"
            android:label="@string/widget_label_grid">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/step_widget_grid_info" />
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
