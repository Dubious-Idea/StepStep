<?xml version="1.0" encoding="utf-8"?>
<!-- Collapsed notification body — the lock-screen view.
     Wrapped by DecoratedCustomViewStyle, so the app name and expand affordance
     come from the system and must not be repeated here.

     Text colours come from the compat notification text appearances rather than
     brand tokens: this view is inflated by System UI, whose background follows
     the device theme, and hardcoded light text would vanish on a light one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <ImageView
        android:id="@+id/notification_ring"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:contentDescription="@string/widget_steps_today" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textSize="22sp"
            tools:text="8 432" />

        <TextView
            android:id="@+id/notification_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Info"
            tools:text="312 ккал · ещё 3 568 до цели" />
    </LinearLayout>
</LinearLayout>
